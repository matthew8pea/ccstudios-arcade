rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then click Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each player's own record: their username and the games they've liked. Only they can see or change it.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // One document per like at likes/{game}/by/{player}. Anyone can count them; players can only add or
    // remove their own, so each account can like a game once.
    match /likes/{game}/by/{uid} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['at']);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Unreleased games: unreleased/{game} holds the key that unlocks that game (see tools/lock-unreleased.mjs).
    // Only these early-access accounts can read it. Add a player as '<username>@ccstudios-arcade.firebaseapp.com'
    // (lowercase). Nobody can write it from the site; you add it by hand in Firestore > Data.
    match /unreleased/{game} {
      allow read: if request.auth != null && request.auth.token.email in [
        'cousincrewstudios@ccstudios-arcade.firebaseapp.com'
      ];
    }
  }
}
